{
  "name": "@inkly/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@inkly/auth": "workspace:*",
    "@inkly/jobs": "workspace:*",
    "@inkly/pdf": "workspace:*",
    "@inkly/storage": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "5.20261015.1",
    "@inkly/domain": "workspace:*",
    "@inkly/testing": "workspace:*",
    "pdf-lib": "1.17.1",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  },
  "scripts": {
    "build:web": "pnpm --filter @inkly/web build",
    "dev": "pnpm build:web && wrangler dev",
    "test": "pnpm build:web && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  }
}
