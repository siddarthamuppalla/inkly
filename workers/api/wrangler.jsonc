{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "inkly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better-Auth needs AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  // ADR-0002: the SPA in apps/web is served as static assets by this Worker.
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/__test/*", "/api/*", "/v0/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inkly",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "inkly-files" }],
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
}
