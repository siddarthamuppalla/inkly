{
  "name": "inkly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "tsc -b && eslint . --max-warnings 0 && prettier --check .",
    "lint:fixtures": "node tools/lint-fixtures/run.mjs",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "dev": "pnpm --filter @inkly/api dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
